# Voice pipeline. Everything is optional: with no keys the app runs the
# simulated adapter, and `npm run render-lines` writes silent placeholder clips.

# Which adapter the session uses: cascaded (default; falls back to the device voice) | simulated (silent timers)
NEXT_PUBLIC_VOICE=cascaded

# Guided demo (default true): the child home shows only today's lesson behind an "استعرض كل المواد" link.
NEXT_PUBLIC_GUIDED_DEMO=true

# Public origin for metadata, canonical links and the sitemap (default https://school.mvp.sa).
NEXT_PUBLIC_SITE_URL=https://school.mvp.sa

# Parent accounts and cross-device sync (Convex). Optional: without a URL the
# app stays local-only and the account section is hidden. `npx convex dev`
# fills these; production uses the project's prod deployment URL.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Set ON THE CONVEX DEPLOYMENT (npx convex env set …), not here:
#   SMTP_HOST=smtp.improvmx.com  SMTP_PORT=587  SMTP_USER=…  SMTP_PASSWORD=…
#   SMTP_FROM="المعلم الذكي <hello@school.mvp.sa>"  APP_URL=https://school.mvp.sa
#   DEMO_AUTH=1   # dev only: returns the sign-in code instead of emailing it

# Teacher voice for `npm run render-lines` and /api/tts (cache misses).
# TTS_PROVIDER=elevenlabs | openai | mock  (defaults to whichever key is set)
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2   # quality model for Arabic; eleven_flash_v2_5 is faster but flatter
# Delivery (defaults tuned for a calm primary-school teacher): steadiness 0–1, expressiveness 0–1, pace 0.7–1.2.
# ELEVENLABS_STABILITY=0.55  ELEVENLABS_STYLE=0.15  ELEVENLABS_SPEED=0.92
# Note: ElevenLabs library voices (e.g. a native Saudi voice) need a paid plan for API use; premade voices work on the free tier.
OPENAI_TTS_VOICE=coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Child speech → text (/api/stt) and answer assessment (/api/assess).
OPENAI_API_KEY=
STT_PROVIDER=          # openai | mock
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ASSESS_PROVIDER=       # openai | heuristic
OPENAI_ASSESS_MODEL=gpt-4o-mini

# Open "ask the teacher" conversation (Gemini Live). LIVE_PROVIDER=gemini | mock | off
# (defaults: gemini when GEMINI_API_KEY is set, mock in development, otherwise off).
GEMINI_API_KEY=
LIVE_PROVIDER=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_API_VERSION=v1beta
LIVE_MAX_SECONDS=120
LIVE_MAX_TURNS=3
