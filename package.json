{
  "name": "ai-teacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render-lines": "node --env-file-if-exists=.env.local --import tsx scripts/render-lines.ts",
    "live:probe": "node --env-file-if-exists=.env.local --import tsx scripts/live-probe.ts",
