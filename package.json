  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.34.2",
    "convex": "^1.45.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
